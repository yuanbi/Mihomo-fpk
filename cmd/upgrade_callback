#!/bin/bash
# 升级后：重新赋予可执行权限并恢复服务。

APP_DEST="${TRIM_APPDEST:-$(cd "$(dirname "$0")/.." && pwd)}"
PKG_VAR="${TRIM_PKGVAR:-/tmp/mihomo-fpk/var}"
CMD_DIR="$(cd "$(dirname "$0")" && pwd)"

for f in "${APP_DEST}/bin/mihomo" "${APP_DEST}/bin/mihomo-panel"; do
    [ -f "${f}" ] && chmod 0755 "${f}" 2>/dev/null
done

# 升级会整目录替换 app/，执行位需要重新补（fnpack 不保留权限）
[ -f "${APP_DEST}/ui/index.cgi" ] && chmod 0755 "${APP_DEST}/ui/index.cgi" 2>/dev/null

mkdir -p "${PKG_VAR}/logs" 2>/dev/null

# 升级会保留 TRIM_PKGETC / TRIM_PKGVAR 中的数据
bash "${CMD_DIR}/main" start >/dev/null 2>&1

exit 0
